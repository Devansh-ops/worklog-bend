{
  "name": "work-log",
  "version": "0.1.0",
  "description": "Worklog with a checked Bend domain core and static browser adapters.",
  "type": "module",
  "license": "MIT",
  "author": "Tanmay Agrawal",
  "keywords": [
    "worklog",
    "kanban",
    "standup",
    "journal",
    "changelog",
    "event-sourcing",
    "github-pages",
    "static-site",
    "zero-dependency"
  ],
  "homepage": "https://github.com/Devansh-ops/worklog-bend",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devansh-ops/worklog-bend.git"
  },
  "bugs": {
    "url": "https://github.com/Devansh-ops/worklog-bend/issues"
  },
  "bin": {
    "work-log": "bin/worklog.mjs"
  },
  "scripts": {
    "start": "node bin/worklog.mjs",
    "test": "node test/run-all.mjs",
    "test:upstream-jsc": "./scripts/test.sh",
    "test:reference-defects": "node test/domain-bridge.mjs && node test/store-integration.mjs && node test/ai-privacy.mjs",
    "test:browser": "node scripts/test-browser-demo.mjs",
    "test:bend": "node scripts/test-bend-toolchain.mjs",
    "test:bend-browser": "node scripts/test-bend-browser.mjs",
    "build": "node scripts/build.mjs",
    "check:build": "node scripts/build.mjs --check",
    "test:proof": "node test/proof/negative.mjs",
    "test:browser:all": "node test/browser-all.mjs",
    "setup:data": "node scripts/setup.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "css/",
    "docs/",
    "js/",
    "scripts/setup.sh",
    "scripts/setup.mjs",
    "scripts/scaffold.mjs",
    "index.html",
    "SETUP.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses/"
  ],
  "dependencies": {},
  "sideEffects": false
}
